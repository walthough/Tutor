{
  "name": "study-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local tutoring terminal, live notes and study dashboard",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:ui": "npm run build && node scripts/workflow-smoke.cjs",
    "test:modes-ui": "npm run build && node scripts/workflow-smoke.cjs",
    "test:quiz-ui": "npm run build && node scripts/quiz-smoke.cjs",
    "test:practice-ui": "npm run build && node scripts/practice-smoke.cjs",
    "test:sources-ui": "npm run build && node scripts/workflow-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "44.7.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0"
  }
}
